# Cloud Ingestion Service - Environment Configuration
# Install to: /etc/enterprise-core-platform/cloud-ingester.env
# 
# IMPORTANT: This file contains sensitive credentials
# Permissions should be: 600 (owner read/write only)
# Owner should be: cloud-ingester:cloud-ingester

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
# AWS credentials via IAM role (recommended) or:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Azure Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_LOCATION=eastus
# Azure credentials via Managed Identity (recommended) or:
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_ZONE=us-central1-a
# GCP credentials via service account:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/enterprise-core-platform/gcp-service-account.json

# Service Configuration
LOG_LEVEL=info
DRY_RUN=false
